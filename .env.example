# Bu dosyayı ".env" olarak kopyalayın ve kendi bilgilerinizle doldurun.
# .env dosyası GitHub'a YÜKLENMEZ (.gitignore ile hariç tutulmuştur).

# Uyarı maillerini gönderecek Gmail hesabı
GONDEREN_MAIL=ornek@gmail.com

# Gmail "Uygulama Şifresi" (16 haneli). Normal şifre DEĞİL.
# https://myaccount.google.com/apppasswords
MAIL_SIFRESI=xxxx xxxx xxxx xxxx

# Uyarıların gideceği yönetici adresi
ALICI_MAIL=yonetici@gmail.com
